# ---- Application ----
APP_NAME=AI Career Intelligence Platform
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

# ---- CORS (comma-separated origins) ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database ----
# SQLite for zero-config local development. Swap for postgres://... if needed.
DATABASE_URL=sqlite:///./backend_data/career_intel.db

# ---- Uploads / parsing ----
MAX_UPLOAD_MB=10
ALLOWED_EXTENSIONS=pdf,docx,txt
MAX_RESUME_CHARS=80000
MAX_JD_CHARS=40000

# ---- Embeddings ----
# auto: OpenAI if key present -> sentence-transformers if installed -> hashing fallback
# force deterministic/offline behavior with: hashing
EMBEDDING_BACKEND=auto
ST_MODEL=all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- LLM (optional â€” the app degrades gracefully to heuristic mode without it) ----
# Option A (paid): OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Option B (FREE): Google Gemini free tier â€” get a key at https://aistudio.google.com
# (no credit card; uses Gemini's OpenAI-compatible endpoint, 15 req/min is plenty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
LLM_ENABLED=true
LLM_TIMEOUT_S=45
LLM_MAX_TOKENS=1500

# ---- Security ----
LLM_GUARD_MAX_CHARS=12000

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FILE=backend_data/app.log
